# ===== 宿主机目录 =====
# 工作区根目录；容器内固定挂到 /workspace。
# 建议用绝对路径并放在项目目录外，避免被 Docker build context 扫描。
WORKSPACE_DIR=./workspace

# 配置、缓存、日志根目录；容器内的具体路径保持不变。
# 例如放到 /data/t3code/config，便于单独备份或换盘。
CONFIG_DIR=./config

# ===== 端口配置 =====
# 容器使用 network_mode: host，没有 ports: 映射。
# 这里改的就是宿主机实际监听端口，改完需要 docker compose up -d 重建容器。
T3_PORT=3773
# T3 监听地址；只允许本机访问改成 127.0.0.1，手机/局域网配对保持 0.0.0.0
T3_BIND=0.0.0.0

ADMIN_PORT=3774
# 管理后台监听地址；只在本机反代时改成 127.0.0.1
ADMIN_BIND=0.0.0.0

# ===== 浏览器 / CDP =====
# 首次启动时写入各 agent 的默认 CDP 地址（宿主机端口）。
# 在管理后台保存过“浏览器 / CDP”设置后，以 config/admin/settings.json 为准。
CDP_URL=http://127.0.0.1:16002

# ===== 资源限制 =====
# Chrome 共享内存；大页面渲染崩溃时调大
SHM_SIZE=1g
# 容器内存上限（mem_limit 和 memswap_limit）
MEM_LIMIT=6g

# ===== 管理后台访问令牌 =====
# 留空时自动生成并保存到 CONFIG_DIR/admin/admin-token
# 建议显式设置一个长随机串；这是 basic auth 的密码，用户名随便填
ADMIN_TOKEN=

# ===== Multica =====
# 容器启动时自动恢复 Multica 配置并拉起 daemon
AUTOSTART_MULTICA=1

# ===== 不要在这里写各 agent 的 API Key =====
# 第三方模型统一在管理后台的“模型配置”里填写，会生成到各 agent 自己的配置文件中。
