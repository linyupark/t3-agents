# ===== 端口配置 =====
# T3 Code Web UI / 配对服务端口（network_mode: host 下直接监听宿主机）
T3_PORT=3773
# 管理后台端口
ADMIN_PORT=3774
# 管理后台监听地址；只在本机反代时改成 127.0.0.1
ADMIN_BIND=0.0.0.0

# ===== 管理后台访问令牌 =====
# 留空时自动生成并保存到 config/admin/admin-token
# 建议显式设置一个长随机串；这是 basic auth 的密码，用户名随便填
ADMIN_TOKEN=

# ===== Multica =====
# 容器启动时自动恢复 Multica 配置并拉起 daemon
AUTOSTART_MULTICA=1

# ===== 不要在这里写各 agent 的 API Key =====
# 第三方模型统一在管理后台的“模型配置”里填写，会生成到各 agent 自己的配置文件中。